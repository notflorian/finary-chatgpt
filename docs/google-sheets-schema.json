        {"name": "market_value_eur", "type": "NUMBER", "nullable": true, "ownership": "automated", "source": "Account.market_value_eur"},
        {"name": "last_seen_at", "type": "DATETIME", "nullable": false, "ownership": "derived", "source": "PortfolioSnapshot.generated_at"},
        {"name": "last_seen_run_id", "type": "STRING", "nullable": false, "ownership": "derived", "source": "sync run context"},
        {"name": "is_active", "type": "BOOLEAN", "nullable": false, "ownership": "derived", "source": "snapshot presence"}
      ]
    },
