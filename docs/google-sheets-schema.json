{
  "schema_version": "2.0",
  "workbook_name": "Finary Portfolio Data",
  "timezone": "Europe/Paris",
  "reference_currency": "EUR",
  "null_cell": "",
  "boolean_values": ["TRUE", "FALSE"],
  "percentage_representation": "decimal_fraction",
  "allocation_target_constraint": "0 <= min_pct <= target_pct <= max_pct <= 1",
  "key_formats": {
    "account_key": "finary:account:{account_id}",
    "source_asset_id": "{position_kind}:{asset_id}",
    "position_key": "finary:{account_id}:asset:{position_kind}:{asset_id}",
    "history_key": "{snapshot_date}:{position_key}",
    "portfolio_daily": "{snapshot_date}",
    "run_id": "YYYYMMDD-HHMMSS"
  },
  "override_matching_precedence": ["source_asset_id", "isin", "ticker", "name_match"],
  "cashflow_sign_convention": {
    "positive": ["CONTRIBUTION", "DIVIDEND", "INTEREST"],
    "negative": ["WITHDRAWAL", "FEE", "TAX"],
    "transfer": "Signed per account; paired equal-and-opposite internal transfers are excluded from external flows."
  },
  "readme_entries": [
    {"key": "reference_currency", "value": "EUR", "description": "All explicitly EUR-normalized workbook values use EUR."},
    {"key": "timezone", "value": "Europe/Paris", "description": "Business dates and schedules use Europe/Paris."},
    {"key": "current_state_rule", "value": "_current sheets contain the latest known valid state, including retained inactive rows", "description": "Inactive current rows are retained rather than deleted."},
    {"key": "history_rule", "value": "positions_history contains daily position snapshots", "description": "Same-date deterministic keys are updated; later dates create rows."},
    {"key": "override_rule", "value": "asset_overrides is authoritative over automatic classification", "description": "Enabled exact-match overrides determine final classification."},
    {"key": "null_rule", "value": "blank means unknown or unavailable; blank never means zero", "description": "Numeric nulls are empty cells, not text or zero placeholders."},
    {"key": "eur_rule", "value": "position EUR fields exist only with verified EUR provenance", "description": "No display-field inference or speculative conversion is allowed."},
    {"key": "gross_assets_rule", "value": "account balances are authoritative; never add position values to account balances", "description": "Position values are analytical components and may overlap account balances."},
    {"key": "failed_snapshot_rule", "value": "an invalid or failed bridge response must not overwrite the last valid state", "description": "Explicit PARTIAL or UNAVAILABLE liability coverage remains a valid asset snapshot."},
    {"key": "liability_rule", "value": "liability_coverage is authoritative; blank liabilities or net worth never means zero", "description": "Net worth may be stated only when liability_coverage is COMPLETE."},
    {"key": "partial_liability_rule", "value": "PARTIAL records are not a complete debt set and are not written to liabilities_current", "description": "Only COMPLETE coverage may modify liabilities_current."},
    {"key": "unavailable_liability_rule", "value": "UNAVAILABLE means no authoritative liability collection", "description": "Gross assets remain analyzable while liability and net-worth totals remain blank."},
    {"key": "last_known_liability_rule", "value": "liabilities_current may contain last-known COMPLETE data", "description": "PARTIAL or UNAVAILABLE asset snapshots preserve the last-known complete liability state."},
    {"key": "allocation_rule", "value": "allocation percentages exclude liabilities and use only known-EUR active positions", "description": "Allocation may describe partial known-EUR coverage."}
  ],
  "enums": {
    "asset_class": ["EQUITY", "BOND", "CASH", "REAL_ESTATE", "SCPI", "PRIVATE_EQUITY", "CRYPTO", "COMMODITY", "LIFE_INSURANCE_FUND", "OTHER"],
    "cashflow_type": ["CONTRIBUTION", "WITHDRAWAL", "DIVIDEND", "INTEREST", "FEE", "TAX", "TRANSFER"],
    "sync_status": ["SUCCESS", "SUCCESS_WITH_WARNINGS", "FAILED"],
    "liability_coverage": ["COMPLETE", "PARTIAL", "UNAVAILABLE"]
  },
  "sheets": {
    "README": {
      "purpose": "Human-readable and ChatGPT-readable workbook data dictionary.",
      "sheet_ownership": "automated",
      "unique_key": "key",
      "update_behavior": "Initialized from the schema definition; portfolio synchronization must not rewrite it.",
      "deletion_behavior": "Never delete automatically.",
      "columns": [
        {"name": "key", "type": "STRING", "nullable": false, "ownership": "automated", "source": "schema definition"},
        {"name": "value", "type": "STRING", "nullable": false, "ownership": "automated", "source": "schema definition"},
        {"name": "description", "type": "STRING", "nullable": false, "ownership": "automated", "source": "schema definition"}
      ]
    },
