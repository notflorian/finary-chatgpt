# Optional local protection for all MCP routes.
FINARY_BRIDGE_API_KEY=

# Independent bridge-owned OAuth state, never an assistant/plugin token store.
# Configure after operator bootstrap; access tokens remain memory-only.
FINARY_MCP_STATE_PATH=

# Local bridge URL.
FINARY_BRIDGE_URL=http://finary-bridge:8000

# MCP writer: initialize a new 4.0 workbook; see docs/operations.md.
FINARY_MCP_SCHEMA_URL=http://schema-server/google-sheets-schema.json
FINARY_MCP_GOOGLE_SHEET_ID=
FINARY_MCP_WRITER_ID=
FINARY_MCP_WRITER_GENERATION=1

# n8n stores this secret locally; generate a strong value before enabling n8n.
N8N_ENCRYPTION_KEY=
N8N_EXECUTIONS_TIMEOUT=300
N8N_EXECUTIONS_TIMEOUT_MAX=300

# Optional localhost port overrides.
FINARY_BRIDGE_PORT=8000
N8N_PORT=5678

# Shared business timezone.
TZ=Europe/Paris
