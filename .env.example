# Used only by the local Finary adapter; keep these values out of version control.
FINARY_EMAIL=
FINARY_PASSWORD=
FINARY_MFA_CODE=
# Optional for direct local runs. Compose uses its bridge-only volume path.
FINARY_SESSION_PATH=
FINARY_BRIDGE_API_KEY=

# Phase 5 n8n workflow configuration. The schema URL must serve the canonical
# docs/google-sheets-schema.json file from this repository.
FINARY_BRIDGE_URL=http://finary-bridge:8000
FINARY_GOOGLE_SHEET_ID=
FINARY_SCHEMA_URL=http://schema-server/google-sheets-schema.json

# n8n stores this secret locally; generate a strong value before enabling n8n.
N8N_ENCRYPTION_KEY=
N8N_EXECUTIONS_TIMEOUT=300
N8N_EXECUTIONS_TIMEOUT_MAX=300

# Optional localhost port overrides.
FINARY_BRIDGE_PORT=8000
N8N_PORT=5678

# Shared business timezone.
TZ=Europe/Paris
